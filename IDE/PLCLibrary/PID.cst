// PID: scalar PID loop with anti-windup. Call pid_step() each scan.

struct PID {
    int kp_x1000;
    int ki_x1000;
    int kd_x1000;
    int setpoint;
    int measurement;
    int integral;
    int prev_error;
    int output;
    int out_min;
    int out_max;
};

int pid_step(struct PID* p) {
    int error = p->setpoint - p->measurement;
    int prop = (p->kp_x1000 * error) / 1000;
    p->integral = p->integral + (p->ki_x1000 * error) / 1000;
    if (p->integral > p->out_max) {
        p->integral = p->out_max;
    }
    if (p->integral < p->out_min) {
        p->integral = p->out_min;
    }
    int deriv = (p->kd_x1000 * (error - p->prev_error)) / 1000;
    int u = prop + p->integral + deriv;
    if (u > p->out_max) u = p->out_max;
    if (u < p->out_min) u = p->out_min;
    p->prev_error = error;
    p->output = u;
    return u;
}
