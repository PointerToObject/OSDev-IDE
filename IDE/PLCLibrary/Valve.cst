// Valve: solenoid/pneumatic valve with open/close commands and position feedback.
// `open_cmd` / `close_cmd` are the coil outputs; `open_fb` / `closed_fb` are the limit switches.

struct Valve {
    int open_cmd_in;
    int close_cmd_in;
    int open_fb;
    int closed_fb;
    int fault;
    int open_cmd_out;
    int close_cmd_out;
    int position;        // 0 = closed, 1 = open, 2 = mid-travel, 3 = fault
};

void valve_step(struct Valve* v) {
    if (v->open_cmd_in && v->close_cmd_in) {
        v->fault = 1;
        v->open_cmd_out = 0;
        v->close_cmd_out = 0;
        v->position = 3;
        return;
    }
    v->open_cmd_out = v->open_cmd_in;
    v->close_cmd_out = v->close_cmd_in;
    if (v->open_fb && !v->closed_fb) {
        v->position = 1;
    } else if (!v->open_fb && v->closed_fb) {
        v->position = 0;
    } else if (!v->open_fb && !v->closed_fb) {
        v->position = 2;
    } else {
        v->fault = 1;
        v->position = 3;
    }
}
