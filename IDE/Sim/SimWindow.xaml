<Window x:Class="OSDevIDE.Sim.SimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CST Simulator" Height="780" Width="1300"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#D4D4D4" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ModeBtn" Click="ModeBtn_Click" Padding="14,6" Background="#3E3E42" Foreground="#D4D4D4" BorderBrush="#5A5A5E">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="ModeIcon" Kind="Pause" Foreground="#FFC107" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModeText" Text="PROGRAM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Scan rate:" VerticalAlignment="Center" Margin="20,0,6,0" Foreground="#858585"/>
                <ComboBox x:Name="ScanRateCombo" Width="100" SelectedIndex="1" SelectionChanged="ScanRate_Changed">
                    <ComboBoxItem Content="1 ms"   Tag="1"/>
                    <ComboBoxItem Content="10 ms"  Tag="10"/>
                    <ComboBoxItem Content="50 ms"  Tag="50"/>
                    <ComboBoxItem Content="100 ms" Tag="100"/>
                    <ComboBoxItem Content="500 ms" Tag="500"/>
                </ComboBox>

                <Button Click="StepOnce_Click" Margin="14,0,0,0" Padding="10,6" Background="#3E3E42" Foreground="#D4D4D4" BorderBrush="#5A5A5E">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StepForward" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Step" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Reset_Click" Margin="6,0,0,0" Padding="10,6" Background="#3E3E42" Foreground="#D4D4D4" BorderBrush="#5A5A5E">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Reset" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="UnforceAll_Click" Margin="6,0,0,0" Padding="10,6"
                        Background="#5A2D0D" Foreground="#FFB955" BorderBrush="#7A4015"
                        ToolTip="Clear all force locks on tags">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockOpenVariant" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock x:Name="UnforceAllText" Text="Unforce All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Routine:" VerticalAlignment="Center" Margin="20,0,6,0" Foreground="#858585"/>
                <TextBlock x:Name="RoutineText" Text="—" VerticalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- Tabs: HMI design/run + Tag grid + Auto HMI -->
        <TabControl Grid.Row="1" Background="#1E1E1E" BorderThickness="0" Padding="0">
            <TabItem Header="HMI">
                <ContentControl x:Name="HmiHost"/>
            </TabItem>
            <TabItem Header="Ladder">
                <ContentControl x:Name="LadderHost"/>
            </TabItem>
            <TabItem Header="Tags">
                <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D2D30"
                          RowBackground="#1E1E1E" AlternatingRowBackground="#23232A"
                          HeadersVisibility="Column"
                          MouseRightButtonUp="TagGrid_RightClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsForced}" Value="True">
                                    <Setter Property="Background" Value="#3A1F00"/>
                                    <Setter Property="Foreground" Value="#FFB955"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="Foreground" Value="#858585"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"  Binding="{Binding Name}"        Width="*"     IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type"  Binding="{Binding DataType}"    Width="80"    IsReadOnly="True"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="180"  IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Auto HMI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="AutoHmiPanel" Margin="14" ItemWidth="220"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ScanCountText" Text="Scans: 0" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock x:Name="ScanTimeText"  Text="Last scan: 0.00 ms" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock x:Name="StatusText"    Text="Loaded." Foreground="White"/>
                <TextBlock x:Name="ForcedCountText" Text="" Foreground="#FFD080" Margin="20,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
