<UserControl x:Class="OSDevIDE.Sim.HmiDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#1B1B1F" Foreground="#D4D4D4" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Padding="8,4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33333A" Offset="0"/>
                    <GradientStop Color="#28282E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DesignModeBtn" Click="ToggleDesignMode_Click" Padding="14,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="DesignModeIcon" Kind="Pencil" Foreground="#FFC107" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DesignModeText" Text="DESIGN" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="10,4" Fill="#3F3F46"/>
                    <Button Click="Save_Click" Padding="10,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Save .hmi  (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Load_Click" Margin="4,0,0,0" Padding="10,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Load .hmi">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Load" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="10,4" Fill="#3F3F46"/>
                    <Button Click="Duplicate_Click" Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Duplicate selection  (Ctrl+D)">
                        <materialDesign:PackIcon Kind="ContentDuplicate" Width="14" Height="14"/>
                    </Button>
                    <Button Click="BringFront_Click" Margin="4,0,0,0" Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Bring to front">
                        <materialDesign:PackIcon Kind="ArrangeBringToFront" Width="14" Height="14"/>
                    </Button>
                    <Button Click="SendBack_Click" Margin="4,0,0,0" Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Send to back">
                        <materialDesign:PackIcon Kind="ArrangeSendToBack" Width="14" Height="14"/>
                    </Button>
                    <Rectangle Width="1" Margin="10,4" Fill="#3F3F46"/>
                    <Button Click="AlignLeft_Click"   Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Align left">
                        <materialDesign:PackIcon Kind="AlignHorizontalLeft" Width="14" Height="14"/>
                    </Button>
                    <Button Click="AlignCenter_Click" Margin="4,0,0,0" Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Align horizontal center">
                        <materialDesign:PackIcon Kind="AlignHorizontalCenter" Width="14" Height="14"/>
                    </Button>
                    <Button Click="AlignTop_Click"    Margin="4,0,0,0" Padding="8,6" Background="#3E3E45" Foreground="#D4D4D4" BorderBrush="#5A5A65" ToolTip="Align top">
                        <materialDesign:PackIcon Kind="AlignVerticalTop" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="HmiPathText" DockPanel.Dock="Right" Text="(unsaved)" Foreground="#858585" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- LEFT SIDEBAR : Palette + Tag tree -->
        <Border Grid.Row="1" Grid.Column="0" Background="#23232A" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,5" Background="#2B2B33">
                    <TextBlock Text="WIDGETS" FontWeight="Bold" Foreground="#888" FontSize="11"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PaletteList" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#383840" BorderBrush="#54545E" BorderThickness="1" Margin="3,2"
                                        Padding="8,6" CornerRadius="3" Cursor="Hand"
                                        MouseLeftButtonDown="Palette_MouseDown"
                                        Tag="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="#9CDCFE"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#D4D4D4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="10,5" Background="#2B2B33" BorderBrush="#3F3F46" BorderThickness="0,1,0,1">
                    <DockPanel>
                        <TextBlock Text="TAGS" FontWeight="Bold" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox x:Name="TagFilterBox" Margin="6,0,0,0" Background="#1B1B1F" Foreground="#D4D4D4" BorderBrush="#3F3F46" FontSize="10" Padding="3" TextChanged="TagFilter_Changed"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="TagTree" Background="Transparent" BorderThickness="0" Foreground="#D4D4D4" SelectedItemChanged="TagTree_SelectedChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- CENTER : Canvas with widgets + overlay (grips/marquee/guides) -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0D0D11" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Canvas x:Name="DesignCanvas" Width="1100" Height="600" Background="#181820"
                            AllowDrop="True" Drop="Canvas_Drop" DragOver="Canvas_DragOver"
                            MouseLeftButtonDown="Canvas_MouseLeftDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftUp"/>
                    <!-- Overlay layer for grips, marquee and alignment guides.
                         No Background here: empty area passes mouse events
                         through to the widgets/canvas below. Grip Rectangles
                         and the marquee Rectangle are hit-testable in their
                         own right (they have Fill). -->
                    <Canvas x:Name="OverlayLayer" Width="1100" Height="600" IsHitTestVisible="True"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- RIGHT : Property panel -->
        <Border Grid.Row="1" Grid.Column="2" Background="#23232A" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2B2B33" Padding="10,5">
                    <TextBlock Text="PROPERTIES" FontWeight="Bold" Foreground="#888" FontSize="11"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyPanel" Margin="10"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- BOTTOM : Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#007ACC" Padding="10,3">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="StatusIcon" Kind="Pencil" Foreground="White" Width="13" Height="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusModeText" Text="DESIGN" Foreground="White" Margin="6,0,18,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusSelectionText" Text="0 selected" Foreground="White" Margin="0,0,18,0"/>
                <TextBlock x:Name="StatusActionText" Text="" Foreground="#CFE8FF" Margin="0,0,18,0"/>
                <TextBlock x:Name="StatusMouseText" Text="" Foreground="#CFE8FF"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
